{
  "name": "quran-recitation-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "data": "node ../data-scripts/build-quran-data.mjs",
    "predev": "node ../data-scripts/build-quran-data.mjs --if-missing",
    "prebuild": "node ../data-scripts/build-quran-data.mjs --if-missing",
    "pretest": "node ../data-scripts/build-quran-data.mjs --if-missing",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "@fontsource/amiri-quran": "^5.3.0",
    "idb": "^8.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "fake-indexeddb": "^6.2.8",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.1"
  }
}
